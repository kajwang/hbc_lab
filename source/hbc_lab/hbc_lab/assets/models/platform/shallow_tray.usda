#usda 1.0
(
    defaultPrim = "ShallowTray"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "ShallowTray" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI"]
)
{
    bool physics:kinematicEnabled = 1
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:disableGravity = 1

    def Cube "Pedestal" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.24, 0.26, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.34, 0.40, 0.50)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Cube "WallFront" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.24, 0.26, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.34, 0.025, 0.05)
        double3 xformOp:translate = (0, 0.1875, 0.275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallBack" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.24, 0.26, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.34, 0.025, 0.05)
        double3 xformOp:translate = (0, -0.1875, 0.275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallLeft" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.24, 0.26, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.025, 0.35, 0.05)
        double3 xformOp:translate = (-0.1575, 0, 0.275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallRight" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.24, 0.26, 0.28)]
        double size = 1
        float3 xformOp:scale = (0.025, 0.35, 0.05)
        double3 xformOp:translate = (0.1575, 0, 0.275)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
