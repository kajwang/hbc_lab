#usda 1.0
(
    defaultPrim = "SceneTable"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SceneTable" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
)
{
    float physics:mass = 1000000
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:disableGravity = 1

    def Xform "Top"
    {
        def Cube "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.38, 0.29, 0.20)]
            double size = 1
            float3 xformOp:scale = (0.90, 1.10, 0.08)
            double3 xformOp:translate = (0, 0, 0.76)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "FrontLeftLeg"
    {
        def Cube "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.30, 0.23, 0.16)]
            double size = 1
            float3 xformOp:scale = (0.07, 0.07, 0.72)
            double3 xformOp:translate = (-0.415, 0.515, 0.36)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "FrontRightLeg"
