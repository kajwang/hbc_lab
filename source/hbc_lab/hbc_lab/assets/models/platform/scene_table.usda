            double3 xformOp:translate = (-0.415, -0.515, 0.36)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "BackLeftLeg"
    {
        def Cube "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.30, 0.23, 0.16)]
            double size = 1
            float3 xformOp:scale = (0.07, 0.07, 0.72)
            double3 xformOp:translate = (0.415, 0.515, 0.36)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "BackRightLeg"
    {
        def Cube "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.30, 0.23, 0.16)]
